# Local development endpoints; Docker overrides these with service addresses.
DATABASE_URL=postgresql+asyncpg://idv_user:idv_password@localhost:55432/idv_db
REDIS_URL=redis://localhost:56379/0
JWT_SECRET_KEY=replace-with-a-random-64-character-hex-value-before-deploying
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
ENVIRONMENT=development
DEBUG=false
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173
HTTP_PORT=8080
API_PORT=18000
POSTGRES_PORT=55432
REDIS_PORT=56379

# The ten-stage pipeline is the sole decision authority.
PIPELINE_PASS_THRESHOLD=0.90
PIPELINE_REVIEW_THRESHOLD=0.75
FACE_SIMILARITY_THRESHOLD=0.6
FRAUD_SCORE_THRESHOLD=0.7
OCR_CONFIDENCE_THRESHOLD=0.85
FACE_BACKEND=deepface
FACE_MODEL=Facenet
INFERENCE_USE_GPU=false
LIVENESS_BACKEND=heuristic
LIVENESS_THRESHOLD=0.75
INSTALL_ENHANCED=false

# Enhanced models: see docs/models.md. Paths are relative to backend locally.
SILENT_FACE_REPO=./third_party/Silent-Face-Anti-Spoofing
SILENT_FACE_MODEL_DIR=./third_party/Silent-Face-Anti-Spoofing/resources/anti_spoof_models
